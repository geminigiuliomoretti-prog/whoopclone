<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Whoop Clone</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>whoop_clone</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- iOS Background Modes per la gestione continua ed il ripristino di stato CoreBluetooth -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>

	<!-- Autorizzazioni descrittive Bluetooth -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>L'applicazione mantiene la connessione con lo strap wearable per il monitoraggio continuo dei parametri fisiologici anche in background.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>L'applicazione utilizza il Bluetooth per comunicare con il sensore di frequenza cardiaca.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>L'applicazione utilizza la posizione per il tracciamento GPS delle attività sportive outdoor.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>L'applicazione utilizza la posizione in background per il tracciamento GPS e la scansione dei dispositivi BLE.</string>

	<!-- CBCentralManagerOptionRestoreIdentifierKey -->
	<key>CBCentralManagerOptionRestoreIdentifierKey</key>
	<string>com.whoop.centralmanager.restoreKey</string>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
